# Paths are restricted to SYNFIG_MCP_WORKSPACE. Point it at a dedicated folder.
SYNFIG_BIN=C:\Program Files\Synfig\bin\synfig.exe
SYNFIG_MCP_WORKSPACE=D:\Projects\synfig-workspace
SYNFIG_MCP_LOG_LEVEL=INFO
SYNFIG_MCP_RENDER_TIMEOUT=300
SYNFIG_MCP_MAX_FRAMES=20000
SYNFIG_MCP_UNIT_PX=60
SYNFIG_MCP_UNIT_SYSTEM=units
# Optional tuning (all have sane defaults):
# SYNFIG_MCP_MAX_RESOLUTION=8192
# SYNFIG_MCP_MAX_LAYERS=5000
# SYNFIG_MCP_MAX_FILE_MB=256
# SYNFIG_MCP_HISTORY_DEPTH=50
# SYNFIG_MCP_RENDER_WORKERS=2
# SYNFIG_MCP_AUTOSAVE=false
