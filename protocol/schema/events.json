{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synfig-mcp.org/schemas/events.json",
  "title": "JsonRpcNotification",
  "type": "object",
  "properties": {
    "jsonrpc": { "const": "2.0" },
    "method": {
      "type": "string",
      "enum": [
        "event.selection_changed",
        "event.time_changed",
        "event.document_changed",
        "event.document_closed"
      ]
    },
    "params": {
      "type": "object",
      "properties": {
        "doc_id": { "type": "string" }
      },
      "required": ["doc_id"]
    }
  },
  "required": ["jsonrpc", "method", "params"],
  "additionalProperties": false
}
